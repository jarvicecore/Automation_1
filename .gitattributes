# Normalise text by default.
* text=auto eol=lf

# These are executed by bash on Linux runners. If they are ever checked out with
# CRLF endings they fail with `$'\r': command not found` -- a genuinely miserable
# thing to debug, because the script looks correct in every editor.
*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# PowerShell is run on Windows by humans; leave it CRLF.
*.ps1       text eol=crlf

*.tar.gz    binary
